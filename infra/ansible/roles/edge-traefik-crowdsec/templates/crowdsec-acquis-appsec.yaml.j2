# Géré par Ansible (rôle edge-traefik-crowdsec)
# AppSec (WAF) interrogé par le bouncer Traefik ; non publié hors du réseau docker.
# Une seule configuration : appsec-default (configuration documentée par CrowdSec). Charger virtual-patching ET
# generic-rules dans le même moteur fait planter CrowdSec au démarrage (« duplicated rule id 100 »).
appsec_configs:
  - crowdsecurity/appsec-default
labels:
  type: appsec
listen_addr: 0.0.0.0:{{ edge_traefik_crowdsec_appsec_port }}
source: appsec
