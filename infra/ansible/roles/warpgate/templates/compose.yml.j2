# Géré par Ansible (rôle warpgate).
name: warpgate
services:
  warpgate:
    image: {{ warpgate_image }}
    container_name: warpgate
    restart: unless-stopped
    ports:
      - "{{ warpgate_ssh_port }}:{{ warpgate_ssh_port }}"
      - "{{ warpgate_https_port }}:{{ warpgate_https_port }}"
      # Même listener HTTPS publié aussi sur le port externe : Warpgate construit ses URL (retour SSO, liens) sur
      # https://<external_host>:<external_port>. Sans ce port, le retour d'Authentik échouait (« Safari can't open »).
      - "{{ warpgate_external_https_port }}:{{ warpgate_https_port }}"
    volumes:
      - ./data:/data
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: {{ warpgate_memory_limit }}
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"
