# Géré par Ansible (rôle netbird-server). Authentification via l'IdP embarqué (connecteur Authentik).
NETBIRD_MGMT_API_ENDPOINT=https://{{ netbird_server_fqdn }}
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://{{ netbird_server_fqdn }}
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY=https://{{ netbird_server_fqdn }}/oauth2
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
# TLS terminé par l'edge : pas de TLS ni de Let's Encrypt dans le conteneur.
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none
