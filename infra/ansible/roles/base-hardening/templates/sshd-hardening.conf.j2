# {{ ansible_managed }}
# Chargé avant les autres drop-ins (première valeur lue = valeur retenue par sshd).
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin {{ base_hardening_ssh_permit_root_login }}
AuthenticationMethods publickey
MaxAuthTries {{ base_hardening_ssh_max_auth_tries }}
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding {{ base_hardening_ssh_allow_tcp_forwarding }}
PermitTunnel no
