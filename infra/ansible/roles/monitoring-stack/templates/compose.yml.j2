# Géré par Ansible (rôle monitoring-stack).
{% set grafana_role_expr %}({% for g in monitoring_stack_grafana_admin_groups %}contains(groups[*], '{{ g }}'){% if not loop.last %} || {% endif %}{% endfor %}) && 'Admin' || 'Viewer'{% endset %}
name: monitoring

x-common: &common
  restart: unless-stopped
  security_opt:
    - no-new-privileges:true
  logging:
    driver: json-file
    options: { max-size: "10m", max-file: "3" }

services:
  victoriametrics:
    <<: *common
    image: {{ monitoring_stack_images.victoriametrics }}
    command:
      - -storageDataPath=/storage
      - -retentionPeriod={{ monitoring_stack_vm_retention }}
      - -httpListenAddr=:{{ pad.ports.monitoring.victoriametrics }}
      - -promscrape.config=/etc/victoriametrics/scrape.yml
      - -promscrape.config.strictParse
      - -loggerFormat=json
    ports:
      - "{{ pad.ports.monitoring.victoriametrics }}:{{ pad.ports.monitoring.victoriametrics }}"
    volumes:
      - vm-data:/storage
      - ./config/victoriametrics/scrape.yml:/etc/victoriametrics/scrape.yml:ro

  vmalert:
    <<: *common
    image: {{ monitoring_stack_images.vmalert }}
    command:
      - -datasource.url=http://victoriametrics:{{ pad.ports.monitoring.victoriametrics }}
      - -remoteWrite.url=http://victoriametrics:{{ pad.ports.monitoring.victoriametrics }}
      - -remoteRead.url=http://victoriametrics:{{ pad.ports.monitoring.victoriametrics }}
      - -notifier.url=http://alertmanager:{{ pad.ports.monitoring.alertmanager }}
      - -rule=/etc/vmalert/rules/*.yml
      - -httpListenAddr=:{{ pad.ports.monitoring.vmalert }}
      - -loggerFormat=json
    volumes:
      - ./config/vmalert/rules:/etc/vmalert/rules:ro
    depends_on:
      - victoriametrics
      - alertmanager

  alertmanager:
    <<: *common
    image: {{ monitoring_stack_images.alertmanager }}
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address=:{{ pad.ports.monitoring.alertmanager }}
      - --web.external-url=https://{{ pad_fqdn.alertmanager }}
      - --log.format=json
    volumes:
      - alertmanager-data:/alertmanager
      - ./config/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - ./config/alertmanager/templates:/etc/alertmanager/templates:ro

  loki:
    <<: *common
    image: {{ monitoring_stack_images.loki }}
    command: ["-config.file=/etc/loki/loki.yml"]
    ports:
      - "{{ pad.ports.monitoring.loki }}:{{ pad.ports.monitoring.loki }}"
    volumes:
      - loki-data:/loki
      - ./config/loki/loki.yml:/etc/loki/loki.yml:ro

  tempo:
    <<: *common
    image: {{ monitoring_stack_images.tempo }}
    command: ["-target=all", "-config.file=/etc/tempo/tempo.yml"]
    ports:
      - "{{ pad.ports.monitoring.otlp_grpc }}:{{ pad.ports.monitoring.otlp_grpc }}"
      - "{{ pad.ports.monitoring.otlp_http }}:{{ pad.ports.monitoring.otlp_http }}"
    volumes:
      - tempo-data:/var/tempo
      - ./config/tempo/tempo.yml:/etc/tempo/tempo.yml:ro
    depends_on:
      - victoriametrics

  grafana:
    <<: *common
    image: {{ monitoring_stack_images.grafana }}
    ports:
      - "{{ pad.monitoring.grafana_port }}:3000"
    environment:
      GF_SERVER_ROOT_URL: {{ monitoring_stack_grafana_url }}
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_SECURITY_SECRET_KEY: ${GRAFANA_SECRET_KEY}
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_LOG_MODE: console
      GF_LOG_CONSOLE_FORMAT: json
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: PenetrateAndDestroy
      GF_AUTH_GENERIC_OAUTH_CLIENT_ID: {{ monitoring_stack_grafana_oidc_client_id }}
      GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: ${GRAFANA_OIDC_CLIENT_SECRET}
      GF_AUTH_GENERIC_OAUTH_SCOPES: openid profile email
      GF_AUTH_GENERIC_OAUTH_USE_PKCE: "true"
      GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP: "true"
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: {{ pad_authentik_url }}/application/o/authorize/
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: {{ pad_authentik_url }}/application/o/token/
      GF_AUTH_GENERIC_OAUTH_API_URL: {{ pad_authentik_url }}/application/o/userinfo/
      GF_AUTH_GENERIC_OAUTH_SIGNOUT_REDIRECT_URL: {{ pad_authentik_url }}/application/o/{{ monitoring_stack_grafana_oidc_client_id }}/end-session/
      GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH: preferred_username
      GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH: name
      GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH: email
      GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH: groups
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: {{ grafana_role_expr | to_json }}
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT: "true"
      GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN: "true"
    volumes:
      - grafana-data:/var/lib/grafana
      - ./config/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./config/grafana/dashboards:/var/lib/grafana/dashboards:ro
    depends_on:
      - victoriametrics
      - loki
      - tempo

  uptime-kuma:
    <<: *common
    image: {{ monitoring_stack_images.uptime_kuma }}
    ports:
      - "{{ pad.ports.monitoring.uptime_kuma }}:3001"
    volumes:
      - uptime-kuma-data:/app/data

volumes:
  vm-data:
  alertmanager-data:
  loki-data:
  tempo-data:
  grafana-data:
  uptime-kuma-data:
