# Géré par Ansible (rôle monitoring-stack). Tempo monolithique (-target=all), stockage local.
stream_over_http_enabled: true

server:
  http_listen_port: {{ pad.ports.monitoring.tempo_http }}
  log_level: info
  log_format: json

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "0.0.0.0:{{ pad.ports.monitoring.otlp_grpc }}"
        http:
          endpoint: "0.0.0.0:{{ pad.ports.monitoring.otlp_http }}"

metrics_generator:
  registry:
    external_labels:
      source: tempo
      cluster: {{ pad.project }}
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://victoriametrics:{{ pad.ports.monitoring.victoriametrics }}/api/v1/write
        send_exemplars: true

compactor:
  compaction:
    block_retention: {{ monitoring_stack_tempo_retention }}

storage:
  trace:
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks

overrides:
  defaults:
    metrics_generator:
      processors: ["span-metrics", "service-graphs"]

usage_report:
  reporting_enabled: false
