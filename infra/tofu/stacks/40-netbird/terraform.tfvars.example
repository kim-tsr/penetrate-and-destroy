# Copier en terraform.tfvars. Aucun secret ici : la passphrase du state passe par TF_VAR_state_passphrase.

# setup_key_type           = "reusable"   # ou "one-off" (voir README, Routing peers)
# setup_key_expiry_seconds = 2592000
# setup_key_usage_limit    = 5
# routing_peer_metric      = 100

# Ports TCP ouverts au staff vers BASTION ; vide = flow_ports.warpgate du contrat (2222, 8888).
# staff_bastion_ports = []

# Rôle de l'utilisateur de service netbird-sync (network_admin recommandé ; admin en repli, voir README).
# netbird_sync_role = "network_admin"

# true = tofu porte l'IdP Authentik + groupes JWT (sinon rôle ansible netbird-server).
# manage_identity_provider = false
