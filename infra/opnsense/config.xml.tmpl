<?xml version="1.0"?>
<!--
  config.xml de bootstrap OPNsense - rendu par OpenTofu (module opnsense-vm, templatefile).
  NE PAS ÉDITER LE RENDU : il contient des secrets (hashs) et vit uniquement dans .state/opnsense/.
  Contenu minimal : interfaces (WAN + VLANs des zones), passerelle, Unbound, SSH restreint,
  utilisateur root (hash bcrypt) avec clé API pour le provider tofu browningluke/opnsense,
  NAT sortant automatique et redirections de ports WAN (contrat wan.public_ports).
  Les règles de filtrage sont posées ensuite par le stack 60-opnsense-rules.
-->
<opnsense>
  <theme>opnsense</theme>
  <system>
    <optimization>normal</optimization>
    <!-- NIC virtio sous Proxmox : sans ces trois options, les paquets ROUTÉS (zones <-> zones, WAN) sortent avec une
         somme de contrôle TCP/UDP invalide et sont jetés par les invités (InCsumErrors) ; seul le trafic vers
         OPNsense lui-même fonctionne. -->
    <disablechecksumoffloading>1</disablechecksumoffloading>
    <disablesegmentationoffloading>1</disablesegmentationoffloading>
    <disablelargereceiveoffloading>1</disablelargereceiveoffloading>
    <hostname>${hostname}</hostname>
    <domain>${domain}</domain>
    <dnsallowoverride>0</dnsallowoverride>
    <timezone>Etc/UTC</timezone>
    <timeservers>0.opnsense.pool.ntp.org 1.opnsense.pool.ntp.org</timeservers>
    <group>
      <name>admins</name>
      <description>System Administrators</description>
      <scope>system</scope>
      <gid>1999</gid>
      <member>0</member>
      <priv>page-all</priv>
    </group>
    <user>
      <name>root</name>
      <descr>System Administrator</descr>
      <scope>system</scope>
      <groupname>admins</groupname>
      <password>${root_password_hash}</password>
      <uid>0</uid>
      <shell>/bin/sh</shell>
      <authorizedkeys>${root_authorized_keys_b64}</authorizedkeys>
      <apikeys>
        <item>
          <key>${api_key}</key>
          <secret>${api_secret_crypt}</secret>
        </item>
      </apikeys>
    </user>
    <nextuid>2000</nextuid>
    <nextgid>2000</nextgid>
    <webgui>
      <protocol>https</protocol>
      <!-- GUI/API uniquement sur l'interface MGMT -->
      <interfaces>${webgui_interfaces}</interfaces>
      <ssl-ciphers/>
      <compression/>
    </webgui>
    <ssh>
      <group>admins</group>
      <enabled>enabled</enabled>
      <!-- pas d'authentification par mot de passe : clé uniquement -->
      <permitrootlogin>1</permitrootlogin>
      <!-- SSH n'écoute que sur MGMT et BASTION -->
      <interfaces>${ssh_interfaces}</interfaces>
      <noauto>1</noauto>
    </ssh>
    <disablenatreflection>yes</disablenatreflection>
    <usevirtualterminal>1</usevirtualterminal>
    <disableconsolemenu>1</disableconsolemenu>
    <serialspeed>115200</serialspeed>
    <primaryconsole>serial</primaryconsole>
    <secondaryconsole>video</secondaryconsole>
    <powerd_ac_mode>hadp</powerd_ac_mode>
    <bogons>
      <interval>monthly</interval>
    </bogons>
    <pf_share_forward>1</pf_share_forward>
    <lb_use_sticky>1</lb_use_sticky>
    <rrdbackup>-1</rrdbackup>
    <netflowbackup>-1</netflowbackup>
  </system>
  <interfaces>
    <wan>
      <enable>1</enable>
      <if>${wan.if}</if>
      <descr>WAN</descr>
      <ipaddr>${wan.ipaddr}</ipaddr>
      <subnet>${wan.subnet}</subnet>
      <gateway>WAN_GW</gateway>
      <blockpriv>${wan.blockpriv ? "1" : ""}</blockpriv>
      <blockbogons>1</blockbogons>
      <spoofmac/>
    </wan>
%{ for z in zones ~}
    <${z.key}>
      <enable>1</enable>
      <if>${z.vlanif}</if>
      <descr>${upper(z.name)}</descr>
      <ipaddr>${z.ip}</ipaddr>
      <subnet>${z.prefix}</subnet>
      <spoofmac/>
    </${z.key}>
%{ endfor ~}
  </interfaces>
  <vlans version="1.0.0">
%{ for z in zones ~}
    <vlan uuid="${z.vlan_uuid}">
      <if>${trunk_if}</if>
      <tag>${z.vlan}</tag>
      <pcp>0</pcp>
      <proto/>
      <descr>${upper(z.name)}</descr>
      <vlanif>${z.vlanif}</vlanif>
    </vlan>
%{ endfor ~}
  </vlans>
  <gateways>
    <gateway_item uuid="${gateway_uuid}">
      <interface>wan</interface>
      <gateway>${wan.gateway}</gateway>
      <name>WAN_GW</name>
      <weight>1</weight>
      <ipprotocol>inet</ipprotocol>
      <descr>Passerelle WAN</descr>
      <defaultgw>1</defaultgw>
      <!-- passerelle hors sous-réseau (IP publique routée en /32) -->
      <fargw>${wan.far_gateway ? "1" : "0"}</fargw>
      <monitor_disable>1</monitor_disable>
    </gateway_item>
  </gateways>
  <unbound>
    <enable>1</enable>
  </unbound>
  <OPNsense>
    <unboundplus version="1.0.12">
      <general>
        <enabled>1</enabled>
        <port>53</port>
        <stats>1</stats>
        <dnssec>1</dnssec>
        <!-- écoute sur toutes les interfaces internes (ACL auto sur les réseaux des interfaces) -->
        <active_interface>${unbound_interfaces}</active_interface>
        <outgoing_interface>wan</outgoing_interface>
        <regdhcp>0</regdhcp>
        <regdhcpstatic>0</regdhcpstatic>
      </general>
    </unboundplus>
  </OPNsense>
  <!-- DHCP désactivé : toutes les IPs sont statiques (contracts.yaml) -->
  <dhcpd/>
  <nat>
    <outbound>
      <!-- NAT sortant automatique : chaque réseau interne est NATé derrière l'adresse WAN -->
      <mode>automatic</mode>
    </outbound>
    <!-- Redirections de ports WAN (DNAT, port forward), une par entrée de wan.public_ports du contrat.
         Posées ici et non par le stack 60 : l'API d_nat (/api/firewall/d_nat) n'existe qu'à partir
         d'OPNsense 26.1 ; en 25.7 les port forwards n'existent qu'au format legacy de config.xml.
         Destination : adresse de l'interface WAN (wanip), IP publique /32 en routed_ip, transit .2 en nat.
         Plage de ports : local-port = premier port de la plage, pf conserve le décalage (même plage côté cible).
         associated-rule-id vide : AUCUNE règle de filtre implicite (ni « rdr pass », ni règle liée). Le passage
         est autorisé par les règles M1 du stack 60 (interface wan, destination = IP interne après DNAT) ;
         le filtrage reste centralisé là, et le reste tombe sur le blocage par défaut journalisé.
         Réflexion NAT désactivée (split-DNS Unbound vers l'IP interne de l'edge, stack 60). -->
%{ for r in nat_rules ~}
    <rule uuid="${r.uuid}">
      <protocol>${r.proto}</protocol>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <descr>${r.descr}</descr>
      <tag/>
      <tagged/>
      <poolopts/>
      <associated-rule-id/>
      <target>${r.target}</target>
      <local-port>${r.local_port}</local-port>
      <natreflection>disable</natreflection>
      <source>
        <any>1</any>
      </source>
      <destination>
        <network>wanip</network>
        <port>${r.port}</port>
      </destination>
    </rule>
%{ endfor ~}
  </nat>
  <filter>
    <!-- Seule la règle anti-lockout implicite (MGMT -> GUI/SSH) existe au bootstrap.
         Toutes les autres règles viennent du stack 60-opnsense-rules (deny par défaut, journalisé). -->
  </filter>
  <syslog>
    <!-- nologdefaultblock absent => le blocage par défaut est journalisé -->
    <reverse/>
  </syslog>
</opnsense>
