# direnv : charge le devshell Nix et la phrase secrète des states OpenTofu à l'entrée dans le dépôt.
# Aucun secret ici : la phrase vient du trousseau macOS (service tf_passphrase), à défaut de ~/.config/pad/state.pass.
# Activation : `direnv allow` (une fois, puis après chaque modification de ce fichier).

use flake

if command -v security >/dev/null 2>&1; then
  TF_VAR_state_passphrase="$(security find-generic-password -s tf_passphrase -w 2>/dev/null)"
fi
if [[ -z "${TF_VAR_state_passphrase:-}" && -r "$HOME/.config/pad/state.pass" ]]; then
  TF_VAR_state_passphrase="$(<"$HOME/.config/pad/state.pass")"
fi
if [[ -n "${TF_VAR_state_passphrase:-}" ]]; then
  export TF_VAR_state_passphrase
else
  log_error "TF_VAR_state_passphrase introuvable (trousseau : service tf_passphrase, ou ~/.config/pad/state.pass)"
fi

# Surcharges locales éventuelles (non versionnées)
source_env_if_exists .envrc.local
