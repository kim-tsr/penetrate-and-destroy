# Exemple de configuration du front. Copier en .env.local (ignoré par Git) ; ne JAMAIS y mettre de vraies valeurs dans le dépôt.
# En production, ces variables viennent du Secret Kubernetes `frontend-secrets` (SOPS) et du ConfigMap/Deployment.

# --- Mode développement : CTFd simulé en mémoire + connexion de test. Interdit avec NODE_ENV=production (démarrage refusé).
PAD_MOCK=1

# --- Auth.js (https://authjs.dev) : secret de chiffrement des sessions (>= 32 caractères) et URL publique canonique
AUTH_SECRET=CHANGEME-CHANGEME-CHANGEME-CHANGEME-0000
AUTH_URL=http://localhost:3000

# --- OIDC Authentik (inutile avec PAD_MOCK=1) ; issuer = https://<auth>.<domaine>/application/o/<client_id>/
AUTH_AUTHENTIK_ISSUER=https://auth.CHANGEME.example.net/application/o/pad-frontend/
AUTH_AUTHENTIK_ID=pad-frontend
AUTH_AUTHENTIK_SECRET=CHANGEME

# --- CTFd (API interne) et secret HMAC partagé avec le plugin sso_bridge (PAD_SSO_SHARED_SECRET côté CTFd)
CTFD_URL=http://ctfd.ctfd.svc.cluster.local:8000
PAD_SSO_SHARED_SECRET=CHANGEME-CHANGEME-CHANGEME-CHANGEME-0000

# --- Valkey (rate limiting, sessions actives, cache de tokens) ; vide = mémoire du processus (dev uniquement)
VALKEY_URL=

# --- Observabilité : jeton Bearer attendu sur /api/metrics (obligatoire en production)
METRICS_TOKEN=CHANGEME
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.example:4317

# --- NetBird (facultatif) : état du tunnel du joueur et URL affichée dans le guide
# NETBIRD_API_URL=https://vpn.CHANGEME.example.net/api
# NETBIRD_API_TOKEN=CHANGEME
# NETBIRD_MANAGEMENT_URL=https://vpn.CHANGEME.example.net

# --- Événement (repli tant qu'aucun manager n'a ouvert le portail) et mode Git
PAD_EVENT_NAME=PenetrateAndDestroy
# PAD_EVENT_START=2026-11-07T09:00:00Z
# PAD_EVENT_END=2026-11-08T09:00:00Z
# PAD_GIT_REPO_URL=https://github.com/OWNER/REPO.git
# PAD_GIT_SYNC_STATUS_URL=https://example.invalid/sync-status.json

# --- Limites (valeurs par défaut)
# PAD_FLAG_RATE_LIMIT=10
# PAD_FLAG_RATE_WINDOW_S=60
# PAD_API_RATE_LIMIT=1200
