{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinDigests"],
  "argocd": { "fileMatch": ["^gitops/.+\\.ya?ml$"] },
  "kubernetes": { "fileMatch": ["^gitops/.+\\.ya?ml$"] },
  "packageRules": [
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true },
    {
      "description": "Images du projet : tag (sha court) et empreinte sont réécrits par images.yml (task apps:pin-digests).",
      "matchPackageNames": ["/^ghcr\\.io/[^/]+/pad-/", "/^registry\\.pad\\.internal/ctf//"],
      "enabled": false
    }
  ]
}
